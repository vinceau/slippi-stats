  "version": "0.0.1",
  "scripts": {
    "start": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vite test",
    "typecheck": "tsc --noEmit --skipLibCheck",
    "analyze": "source-map-explorer 'build/static/js/*.js'",
